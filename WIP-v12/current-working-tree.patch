+        fun hostOf(value: String): String {
+            val v = value.trim().lowercase()
+            val noScheme = v.substringAfter("://", v)
+            return noScheme.substringBefore('/').substringBefore('?').substringBefore('#').substringAfterLast('@').substringBefore(':')
+        }
+    }
+}
