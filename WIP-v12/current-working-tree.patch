diff --git a/WIP-v12/repository/app/src/test/java/com/fable/browser/engine/ContentBlockerTest.kt b/WIP-v12/repository/app/src/test/java/com/fable/browser/engine/ContentBlockerTest.kt
new file mode 100644
index 0000000..8e26dcf
--- /dev/null
+++ b/WIP-v12/repository/app/src/test/java/com/fable/browser/engine/ContentBlockerTest.kt
@@ -0,0 +1,152 @@
+package com.fable.browser.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ContentBlockerTest {
+    private val list = """
+        [Adblock Plus 2.0]
+        ! Title: test list
+        ||doubleclick.net^
+        ||ads.example.com^
+        ||tracker.test^${'$'}third-party
+        ||partner.example.com/pixel^
+        /adframe.
+        -ad-banner-
+        @@||ads.example.com/allowed^
+        @@||whitelisted.doubleclick.net^
+        example.com##.sidebar-ad
+        ! trailing comment
+    """.trimIndent()
+
+    private fun filters() = ContentBlocker.parse(list)
+
+    @Test
+    fun `domain rules are parsed and matched`() {
+        val f = filters()
+        assertTrue(ContentBlocker.shouldBlock(f, "https://doubleclick.net/x.js", "news.test"))
+        assertTrue(ContentBlocker.shouldBlock(f, "https://ads.example.com/a.gif", "news.test"))
+    }
+
+    @Test
+    fun `subdomains of a blocked domain are blocked`() {
+        val f = filters()
+        assertTrue(
+            ContentBlocker.shouldBlock(f, "https://static.ads.example.com/a.gif", "news.test")
+        )
+    }
+
+    @Test
+    fun `unrelated requests are allowed`() {
+        val f = filters()
+        assertFalse(ContentBlocker.shouldBlock(f, "https://example.com/app.js", "example.com"))
+        assertFalse(ContentBlocker.shouldBlock(f, "https://cdn.wikipedia.org/x.css", "wikipedia.org"))
+    }
+
+    @Test
+    fun `exception rules win over block rules`() {
+        val f = filters()
+        assertFalse(
+            ContentBlocker.shouldBlock(f, "https://whitelisted.doubleclick.net/x.js", "news.test")
+        )
+        assertFalse(
+            ContentBlocker.shouldBlock(f, "https://ads.example.com/allowed/a.gif", "news.test")
+        )
+    }
+
+    @Test
+    fun `first-party requests to a listed domain are not blocked`() {
+        val f = filters()
+        assertFalse(
+            ContentBlocker.shouldBlock(f, "https://ads.example.com/a.gif", "ads.example.com")
+        )
+        assertFalse(
+            ContentBlocker.shouldBlock(f, "https://static.ads.example.com/a.gif", "ads.example.com")
+        )
+    }
+
+    @Test
+    fun `substring rules match anywhere in the url`() {
+        val f = filters()
+        assertTrue(ContentBlocker.shouldBlock(f, "https://cdn.test/js/adframe.js", "news.test"))
+        assertTrue(ContentBlocker.shouldBlock(f, "https://cdn.test/x-ad-banner-1.png", "news.test"))
+        assertFalse(ContentBlocker.shouldBlock(f, "https://cdn.test/js/frame.js", "news.test"))
+    }
+
+    @Test
+    fun `path rules become substring rules`() {
+        val f = filters()
+        assertTrue(
+            ContentBlocker.shouldBlock(f, "https://partner.example.com/pixel?id=1", "news.test")
+        )
+        assertFalse(
+            ContentBlocker.shouldBlock(f, "https://partner.example.com/legit.js", "news.test")
+        )
+    }
+
+    @Test
+    fun `cosmetic and comment lines are ignored`() {
+        val f = filters()
+        assertEquals(3, f.blockedDomains.size)
+        assertTrue(f.blockedDomains.contains("doubleclick.net"))
+        assertTrue(f.blockedDomains.contains("ads.example.com"))
+        assertTrue(f.blockedDomains.contains("tracker.test"))
+        assertFalse(f.blockedSubstrings.any { it.contains("sidebar-ad") })
+    }
+
+    @Test
+    fun `third-party option is supported`() {
+        val f = filters()
+        assertTrue(ContentBlocker.shouldBlock(f, "https://tracker.test/t.gif", "news.test"))
+    }
+
+    @Test
+    fun `wildcard domain rules are skipped rather than over-blocking`() {
+        val f = ContentBlocker.parse("||*.evil^")
+        assertFalse(ContentBlocker.shouldBlock(f, "https://a.evil/x.js", "news.test"))
+    }
+
+    @Test
+    fun `rule count reports both buckets`() {
+        val f = filters()
+        assertEquals(f.blockedDomains.size + f.blockedSubstrings.size, f.ruleCount)
+    }
+
+    @Test
+    fun `an empty list blocks nothing`() {
+        val f = ContentBlocker.parse("")
+        assertEquals(0, f.ruleCount)
+        assertFalse(ContentBlocker.shouldBlock(f, "https://doubleclick.net/x.js", "news.test"))
+    }
+
+    @Test
+    fun `requests without a host are never blocked`() {
+        val f = filters()
+        assertFalse(ContentBlocker.shouldBlock(f, "about:blank", "news.test"))
+        assertFalse(ContentBlocker.shouldBlock(f, "data:text/html,adframe.", "news.test"))
+    }
+
+    @Test
+    fun `cosmetic rules are collected per domain and generic`() {
+        val f = ContentBlocker.parse("example.com##.sidebar-ad\n##.ad-banner\nexample.com#@#.ad-banner\n##div:-abp-has(.x)")
+        assertEquals(listOf(".ad-banner"), f.cosmeticGeneric)
+        assertEquals(listOf(".sidebar-ad"), f.cosmeticDomains["example.com"])
+        assertTrue(f.cosmeticExceptions["example.com"]!!.contains(".ad-banner"))
+    }
+
+    @Test
+    fun `hosts file lines become domain rules`() {
+        val f = ContentBlocker.parse("0.0.0.0 ads.hosts.test\n127.0.0.1 localhost")
+        assertTrue(ContentBlocker.shouldBlock(f, "https://ads.hosts.test/a.js", "news.test"))
+        assertFalse(f.blockedDomains.contains("localhost"))
+    }
+
+    @Test
+    fun `rules with unsupported options are skipped`() {
+        val f = ContentBlocker.parse("||onlyon.test^${'$'}domain=news.test\n||cdn.test/ads/*/x.js")
+        assertFalse(ContentBlocker.shouldBlock(f, "https://onlyon.test/a.js", "other.test"))
+        assertTrue(ContentBlocker.shouldBlock(f, "https://cdn.test/ads/1/x.js", "news.test"))
+    }
+}
diff --git a/WIP-v12/repository/app/src/test/java/com/fable/browser/engine/SuperIdentityFactoryTest.kt b/WIP-v12/repository/app/src/test/java/com/fable/browser/engine/SuperIdentityFactoryTest.kt
new file mode 100644
index 0000000..99c1b95
--- /dev/null
+++ b/WIP-v12/repository/app/src/test/java/com/fable/browser/engine/SuperIdentityFactoryTest.kt
@@ -0,0 +1,59 @@
+package com.fable.browser.engine
+
+import com.fable.browser.data.model.SuperDeviceRange
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SuperIdentityFactoryTest {
+    @Test
+    fun everyRangeMakesUsableIdentities() {
+        SuperDeviceRange.values().forEach { range ->
+            repeat(40) {
+                val id = SuperIdentityFactory.create(range, "", true)
+                assertTrue(id.ua.startsWith("Mozilla/5.0 ("))
+                assertTrue(id.fonts.isNotEmpty())
+                assertTrue(id.languages.isNotEmpty())
+                assertTrue(id.cores > 0)
+                assertTrue(id.screenWidth > 0 && id.screenHeight > 0)
+                assertTrue(id.timeZone.isNotEmpty())
+                assertTrue(id.canvasNoise in 1..3)
+                when (range) {
+                    SuperDeviceRange.PHONES -> assertTrue(id.ua.contains("Android") && id.ua.contains("Mobile"))
+                    SuperDeviceRange.COMPUTERS -> assertTrue(id.desktop)
+                    SuperDeviceRange.IPHONES -> assertTrue(id.ua.contains("iPhone"))
+                    else -> Unit
+                }
+            }
+        }
+    }
+
+    @Test
+    fun pickedDeviceIsUsedButDetailsStayRandom() {
+        val label = SuperIdentityFactory.deviceChoices().first { it.group == "Windows" }.label
+        val ids = (1..30).map { SuperIdentityFactory.create(SuperDeviceRange.PHONES, label, false) }
+        ids.forEach {
+            assertTrue(it.label.startsWith(label))
+            assertTrue(it.ua.contains("Windows NT"))
+            assertEquals("", it.timeZone)
+        }
+        assertTrue(ids.map { it.seed }.toSet().size > 25)
+        assertTrue(ids.map { it.fonts }.toSet().size > 5)
+    }
+
+    @Test
+    fun avoidsForbiddenUserAgents() {
+        val first = SuperIdentityFactory.create(SuperDeviceRange.COMPUTERS, "", true)
+        val again = SuperIdentityFactory.create(SuperDeviceRange.ANY, "", true, setOf(first.ua))
+        assertFalse(again.ua == first.ua && again.label == first.label)
+    }
+
+    @Test
+    fun acceptLanguageHasQualityValues() {
+        val id = SuperIdentityFactory.create(SuperDeviceRange.ANY, "", true)
+        val header = id.acceptLanguage()
+        assertTrue(header.startsWith(id.languages.first()))
+        if (id.languages.size > 1) assertTrue(header.contains(";q=0."))
+    }
+}
diff --git a/WIP-v12/repository/app/src/test/java/com/fable/browser/util/UrlUtilsTest.kt b/WIP-v12/repository/app/src/test/java/com/fable/browser/util/UrlUtilsTest.kt
new file mode 100644
index 0000000..f29b44c
--- /dev/null
+++ b/WIP-v12/repository/app/src/test/java/com/fable/browser/util/UrlUtilsTest.kt
@@ -0,0 +1,210 @@
+package com.fable.browser.util
+
+import com.fable.browser.data.model.SearchEngine
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class UrlUtilsTest {
+    @Test
+    fun `hostnames with a dot are treated as urls`() {
+        assertTrue(UrlUtils.isLikelyUrl("google.com"))
+        assertTrue(UrlUtils.isLikelyUrl("news.ycombinator.com/newest"))
+        assertTrue(UrlUtils.isLikelyUrl("example.co.uk?q=1"))
+    }
+
+    @Test
+    fun `explicit schemes are urls`() {
+        assertTrue(UrlUtils.isLikelyUrl("https://example.com"))
+        assertTrue(UrlUtils.isLikelyUrl("http://example.com"))
+        assertTrue(UrlUtils.isLikelyUrl("about:blank"))
+        assertTrue(UrlUtils.isLikelyUrl("mailto:me@example.com"))
+        assertTrue(UrlUtils.isLikelyUrl("intent://scan/#Intent;scheme=zxing;end"))
+    }
+
+    @Test
+    fun `localhost and ip literals are urls`() {
+        assertTrue(UrlUtils.isLikelyUrl("localhost"))
+        assertTrue(UrlUtils.isLikelyUrl("localhost:8080/admin"))
+        assertTrue(UrlUtils.isLikelyUrl("192.168.1.1"))
+        assertTrue(UrlUtils.isLikelyUrl("127.0.0.1:3000/path"))
+    }
+
+    @Test
+    fun `words and sentences are searches`() {
+        assertFalse(UrlUtils.isLikelyUrl("kotlin"))
+        assertFalse(UrlUtils.isLikelyUrl("how to build an android browser"))
+        assertFalse(UrlUtils.isLikelyUrl("best pizza near me"))
+        assertFalse(UrlUtils.isLikelyUrl("what is 2 + 2"))
+        assertFalse(UrlUtils.isLikelyUrl(""))
+        assertFalse(UrlUtils.isLikelyUrl("   "))
+    }
+
+    @Test
+    fun `a dotted phrase with spaces is still a search`() {
+        assertFalse(UrlUtils.isLikelyUrl("i went to google.com yesterday"))
+    }
+
+    @Test
+    fun `trailing or leading dots do not make a url`() {
+        assertFalse(UrlUtils.isLikelyUrl("hello."))
+        assertFalse(UrlUtils.isLikelyUrl(".hello"))
+    }
+
+    @Test
+    fun `bare hosts are upgraded to https never http`() {
+        assertEquals("https://example.com", UrlUtils.normalizeInput("example.com", "s?q=%s"))
+        assertEquals(
+            "https://example.com/a/b?c=d",
+            UrlUtils.normalizeInput("example.com/a/b?c=d", "s?q=%s")
+        )
+    }
+
+    @Test
+    fun `explicit http is preserved so the interstitial can warn`() {
+        assertEquals("http://example.com", UrlUtils.normalizeInput("http://example.com", "s?q=%s"))
+        assertTrue(UrlUtils.isInsecure("http://example.com"))
+        assertFalse(UrlUtils.isInsecure("https://example.com"))
+    }
+
+    @Test
+    fun `non-url input becomes a search url for the chosen engine`() {
+        assertEquals(
+            "https://www.google.com/search?q=kotlin+flows",
+            UrlUtils.toUrlOrSearch("kotlin flows", SearchEngine.GOOGLE)
+        )
+        assertEquals(
+            "https://duckduckgo.com/?q=kotlin+flows",
+            UrlUtils.toUrlOrSearch("kotlin flows", SearchEngine.DUCKDUCKGO)
+        )
+    }
+
+    @Test
+    fun `search queries are percent encoded`() {
+        assertEquals(
+            "https://www.bing.com/search?q=c%2B%2B+%26+rust",
+            UrlUtils.toUrlOrSearch("c++ & rust", SearchEngine.BING)
+        )
+    }
+
+    @Test
+    fun `custom schemes pass through untouched`() {
+        assertEquals(
+            "mailto:me@example.com",
+            UrlUtils.normalizeInput("mailto:me@example.com", "s?q=%s")
+        )
+        assertEquals("about:blank", UrlUtils.normalizeInput("about:blank", "s?q=%s"))
+    }
+
+    @Test
+    fun `https upgrade helper rewrites only http`() {
+        assertEquals("https://a.example", UrlUtils.upgradeToHttps("http://a.example"))
+        assertEquals("https://a.example", UrlUtils.upgradeToHttps("https://a.example"))
+        assertEquals("about:blank", UrlUtils.upgradeToHttps("about:blank"))
+    }
+
+    @Test
+    fun `host strips userinfo port and case`() {
+        assertEquals("example.com", UrlUtils.host("https://user:pw@Example.com:8443/path?a=b"))
+        assertEquals("example.com", UrlUtils.host("example.com/path"))
+        assertEquals("2001:db8::1", UrlUtils.host("https://[2001:db8::1]:8080/"))
+    }
+
+    @Test
+    fun `host is null for authority-less urls`() {
+        assertNull(UrlUtils.host("about:blank"))
+        assertNull(UrlUtils.host("mailto:me@example.com"))
+        assertNull(UrlUtils.host("data:text/html,hello"))
+    }
+
+    @Test
+    fun `origin is the permission key`() {
+        assertEquals("https://example.com", UrlUtils.origin("https://example.com/a/b?c=d"))
+        assertEquals("https://example.com:8443", UrlUtils.origin("https://example.com:8443/a"))
+    }
+
+    @Test
+    fun `display host drops the www prefix`() {
+        assertEquals("example.com", UrlUtils.displayHost("https://www.example.com/x"))
+        assertEquals("about:blank", UrlUtils.displayHost("about:blank"))
+    }
+
+    @Test
+    fun `same site matches subdomains only`() {
+        assertTrue(UrlUtils.isSameSite("cdn.example.com", "example.com"))
+        assertTrue(UrlUtils.isSameSite("example.com", "example.com"))
+        assertFalse(UrlUtils.isSameSite("notexample.com", "example.com"))
+        assertFalse(UrlUtils.isSameSite(null, "example.com"))
+    }
+
+    @Test
+    fun `scheme classification routes external links to the os`() {
+        assertTrue(UrlUtils.isExternalScheme("mailto:me@example.com"))
+        assertTrue(UrlUtils.isExternalScheme("tel:+15551234"))
+        assertTrue(UrlUtils.isExternalScheme("market://details?id=com.example"))
+        assertTrue(UrlUtils.isExternalScheme("intent://x#Intent;end"))
+        assertFalse(UrlUtils.isExternalScheme("https://example.com"))
+        assertTrue(UrlUtils.isWebScheme("https://example.com"))
+        assertTrue(UrlUtils.isWebScheme("about:blank"))
+        assertFalse(UrlUtils.isWebScheme("tel:+15551234"))
+    }
+
+    @Test
+    fun `utm parameters are removed`() {
+        assertEquals(
+            "https://example.com/article",
+            UrlUtils.stripTrackingParams(
+                "https://example.com/article?utm_source=twitter&utm_medium=social&utm_campaign=x"
+            )
+        )
+    }
+
+    @Test
+    fun `click ids are removed`() {
+        assertEquals(
+            "https://shop.example/item",
+            UrlUtils.stripTrackingParams(
+                "https://shop.example/item?fbclid=abc&gclid=def&igshid=ghi&mc_eid=jkl&msclkid=mno"
+            )
+        )
+    }
+
+    @Test
+    fun `legitimate parameters survive`() {
+        assertEquals(
+            "https://example.com/search?q=privacy&page=2",
+            UrlUtils.stripTrackingParams(
+                "https://example.com/search?q=privacy&utm_source=news&page=2"
+            )
+        )
+    }
+
+    @Test
+    fun `fragments are preserved`() {
+        assertEquals(
+            "https://example.com/doc#section-3",
+            UrlUtils.stripTrackingParams("https://example.com/doc?utm_source=x#section-3")
+        )
+        assertEquals(
+            "https://example.com/doc?q=1#section-3",
+            UrlUtils.stripTrackingParams("https://example.com/doc?q=1&gclid=x#section-3")
+        )
+    }
+
+    @Test
+    fun `urls without tracking params are returned identically`() {
+        val url = "https://example.com/a?b=c&d=e"
+        assertEquals(url, UrlUtils.stripTrackingParams(url))
+        assertEquals("https://example.com/a", UrlUtils.stripTrackingParams("https://example.com/a"))
+    }
+
+    @Test
+    fun `parameter matching is case insensitive`() {
+        assertEquals(
+            "https://example.com/a",
+            UrlUtils.stripTrackingParams("https://example.com/a?UTM_Source=x&FBCLID=y")
+        )
+    }
+}
