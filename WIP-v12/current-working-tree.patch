+
+    renaming?.let { target ->
+        TextPromptDialog(
+            title = "Rename folder",
+            label = "Folder name",
+            initial = target.name,
+            onDismiss = { renaming = null },
+            onConfirm = {
+                viewModel.renameFolder(target, it)
+                renaming = null
+            }
