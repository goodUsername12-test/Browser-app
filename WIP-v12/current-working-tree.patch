diff --git a/WIP-v12/repository/desktop/src/FableBrowser/Resources/newtab.js b/WIP-v12/repository/desktop/src/FableBrowser/Resources/newtab.js
new file mode 100644
index 0000000..ae80464
--- /dev/null
+++ b/WIP-v12/repository/desktop/src/FableBrowser/Resources/newtab.js
@@ -0,0 +1,60 @@
+(function () {
+  "use strict";
+  var params = new URLSearchParams(location.search);
+  var mode = params.get("mode") || "normal";
+  if (mode !== "incognito" && mode !== "super") mode = "normal";
+  document.body.className = mode;
+  var notes = {
+    normal: "",
+    incognito: "Incognito. Nothing from this tab is written to disk, and it is wiped when the tab closes.",
+    super: "Super incognito. This tab has its own made-up device and its own cookies and storage."
+  };
+  document.getElementById("note").textContent = notes[mode];
+  if (mode === "incognito") document.getElementById("title").textContent = "Incognito";
+  if (mode === "super") document.getElementById("title").textContent = "Super incognito";
+  var bridge = window.chrome && window.chrome.webview;
+  var palette = ["#6d36c2", "#ff2e7e", "#ff7417", "#2e9bff", "#1fb57a", "#c2368f", "#3b4bd6", "#d6823b"];
+
+  function colorFor(text) {
+    var h = 0;
+    for (var i = 0; i < text.length; i++) h = (h * 31 + text.charCodeAt(i)) >>> 0;
+    return palette[h % palette.length];
+  }
+
+  function render(items) {
+    var root = document.getElementById("tiles");
+    root.textContent = "";
+    items.slice(0, 12).forEach(function (item) {
+      if (!item || typeof item.url !== "string" || !/^https?:/i.test(item.url)) return;
+      var a = document.createElement("a");
+      a.className = "tile";
+      a.href = item.url;
+      a.title = item.title || item.url;
+      var label = String(item.label || item.title || item.url);
+      var badge = document.createElement("span");
+      badge.className = "badge";
+      badge.style.background = colorFor(label);
+      badge.textContent = label.charAt(0).toUpperCase();
+      var text = document.createElement("span");
+      text.className = "label";
+      text.textContent = label;
+      a.appendChild(badge);
+      a.appendChild(text);
+      root.appendChild(a);
+    });
+  }
+
+  document.getElementById("search").addEventListener("submit", function (e) {
+    e.preventDefault();
+    var text = document.getElementById("query").value.trim();
+    if (text && bridge) bridge.postMessage({ type: "open", text: text });
+  });
+
+  if (bridge) {
+    bridge.addEventListener("message", function (e) {
+      var data = e.data;
+      if (data && data.type === "tiles" && Array.isArray(data.items)) render(data.items);
+    });
+    bridge.postMessage({ type: "ready", mode: mode });
+  }
+})();
diff --git a/WIP-v12/repository/desktop/src/FableBrowser/Resources/shield.js b/WIP-v12/repository/desktop/src/FableBrowser/Resources/shield.js
new file mode 100644
index 0000000..69393f1
--- /dev/null
+++ b/WIP-v12/repository/desktop/src/FableBrowser/Resources/shield.js
@@ -0,0 +1,173 @@
+(function (cfg) {
+  "use strict";
+  if (!cfg) return;
+  var host = "";
+  try { host = String(location.hostname || "").toLowerCase(); } catch (e) { host = ""; }
+  var trusted = cfg.trusted || [];
+  for (var t = 0; t < trusted.length; t++) {
+    if (host === trusted[t] || host.slice(-(trusted[t].length + 1)) === "." + trusted[t]) return;
+  }
+
+  function hash32(text, seed) {
+    var h = (seed >>> 0) ^ 0x811c9dc5;
+    for (var i = 0; i < text.length; i++) {
+      h ^= text.charCodeAt(i);
+      h = Math.imul(h, 0x01000193) >>> 0;
+    }
+    return h >>> 0;
+  }
+
+  function prng(seed) {
+    var a = seed >>> 0;
+    return function () {
+      a = (a + 0x6d2b79f5) >>> 0;
+      var r = Math.imul(a ^ (a >>> 15), 1 | a);
+      r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
+      return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
+    };
+  }
+
+  var baseSeed = hash32(host, cfg.seed >>> 0);
+
+  function getter(proto, name, value) {
+    if (!proto) return;
+    var d = Object.getOwnPropertyDescriptor(proto, name);
+    if (!d || typeof d.get !== "function") return;
+    Object.defineProperty(proto, name, {
+      get: function () { return value; },
+      set: undefined,
+      enumerable: d.enumerable,
+      configurable: true
+    });
+  }
+
+  if (cfg.canvas > 0) {
+    var level = cfg.canvas;
+    var noisify = function (data, w, h) {
+      if (!data || !w || !h) return;
+      var count = Math.min(64, Math.max(4, Math.floor((w * h) / 4096))) * level;
+      var r = prng(baseSeed ^ Math.imul(w, 73856093) ^ Math.imul(h, 19349663));
+      for (var k = 0; k < count; k++) {
+        var p = Math.floor(r() * w * h) * 4 + Math.floor(r() * 3);
+        if (p < data.length && data[p + (3 - (p % 4))] !== 0) data[p] = data[p] ^ 1;
+      }
+    };
+    var ctx2d = window.CanvasRenderingContext2D && window.CanvasRenderingContext2D.prototype;
+    var origGetImageData = ctx2d && ctx2d.getImageData;
+    if (origGetImageData) {
+      ctx2d.getImageData = function () {
+        var img = origGetImageData.apply(this, arguments);
+        try { noisify(img.data, img.width, img.height); } catch (e) {}
+        return img;
+      };
+    }
+    var off2d = window.OffscreenCanvasRenderingContext2D && window.OffscreenCanvasRenderingContext2D.prototype;
+    var origOffGetImageData = off2d && off2d.getImageData;
+    if (origOffGetImageData) {
+      off2d.getImageData = function () {
+        var img = origOffGetImageData.apply(this, arguments);
+        try { noisify(img.data, img.width, img.height); } catch (e) {}
+        return img;
+      };
+    }
+    var canvasProto = window.HTMLCanvasElement && window.HTMLCanvasElement.prototype;
+    var noisyCopy = function (canvas) {
+      var w = canvas.width, h = canvas.height;
+      if (!w || !h || w * h > 16777216 || !origGetImageData) return null;
+      var copy = document.createElement("canvas");
+      copy.width = w;
+      copy.height = h;
+      var c = copy.getContext("2d");
+      if (!c) return null;
+      c.drawImage(canvas, 0, 0);
+      var img = origGetImageData.call(c, 0, 0, w, h);
+      noisify(img.data, w, h);
+      c.putImageData(img, 0, 0);
+      return copy;
+    };
+    if (canvasProto && canvasProto.toDataURL) {
+      var origToDataURL = canvasProto.toDataURL;
+      canvasProto.toDataURL = function () {
+        var copy = null;
+        try { copy = noisyCopy(this); } catch (e) { copy = null; }
+        return origToDataURL.apply(copy || this, arguments);
+      };
+    }
+    if (canvasProto && canvasProto.toBlob) {
+      var origToBlob = canvasProto.toBlob;
+      canvasProto.toBlob = function () {
+        var copy = null;
+        try { copy = noisyCopy(this); } catch (e) { copy = null; }
+        return origToBlob.apply(copy || this, arguments);
+      };
+    }
+  }
+
+  if (cfg.audio > 0) {
+    var audioLevel = cfg.audio;
+    var touched = new WeakSet();
+    var bufferProto = window.AudioBuffer && window.AudioBuffer.prototype;
+    if (bufferProto && bufferProto.getChannelData) {
+      var origGetChannelData = bufferProto.getChannelData;
+      bufferProto.getChannelData = function () {
+        var data = origGetChannelData.apply(this, arguments);
+        try {
+          if (data && !touched.has(data)) {
+            touched.add(data);
+            var r = prng(baseSeed ^ data.length);
+            for (var i = 0; i < data.length; i += 97) data[i] = data[i] + (r() - 0.5) * 1e-7 * audioLevel;
+          }
+        } catch (e) {}
+        return data;
+      };
+    }
+    var analyserProto = window.AnalyserNode && window.AnalyserNode.prototype;
+    if (analyserProto && analyserProto.getFloatFrequencyData) {
+      var origFreq = analyserProto.getFloatFrequencyData;
+      analyserProto.getFloatFrequencyData = function (array) {
+        var result = origFreq.apply(this, arguments);
+        try {
+          var r = prng(baseSeed ^ 0x9e3779b9);
+          for (var i = 0; i < array.length; i += 13) array[i] = array[i] + (r() - 0.5) * 1e-4 * audioLevel;
+        } catch (e) {}
+        return result;
+      };
+    }
+  }
+
+  if (cfg.glVendor && cfg.glRenderer) {
+    ["WebGLRenderingContext", "WebGL2RenderingContext"].forEach(function (name) {
+      var proto = window[name] && window[name].prototype;
+      if (!proto || !proto.getParameter) return;
+      var origGetParameter = proto.getParameter;
+      proto.getParameter = function (p) {
+        if (p === 0x9245) return cfg.glVendor;
+        if (p === 0x9246) return cfg.glRenderer;
+        return origGetParameter.apply(this, arguments);
+      };
+    });
+  }
+
+  if (cfg.screen) {
+    var s = cfg.screen;
+    var screenProto = window.Screen && window.Screen.prototype;
+    getter(screenProto, "width", s.width);
+    getter(screenProto, "height", s.height);
+    getter(screenProto, "availWidth", s.width);
+    getter(screenProto, "availHeight", s.availHeight);
+    getter(screenProto, "colorDepth", 24);
+    getter(screenProto, "pixelDepth", 24);
+  }
+
+  if (cfg.cores > 0) {
+    var navProto = window.Navigator && window.Navigator.prototype;
+    getter(navProto, "hardwareConcurrency", cfg.cores);
+    if (cfg.memory > 0) getter(navProto, "deviceMemory", cfg.memory);
+  }
+
+  if (cfg.webrtc) {
+    ["RTCPeerConnection", "webkitRTCPeerConnection", "RTCDataChannel", "RTCSessionDescription", "RTCIceCandidate"].forEach(function (name) {
+      try { delete window[name]; } catch (e) {}
+    });
+  }
+})(__FABLE_CONFIG__);
diff --git a/WIP-v12/repository/desktop/src/FableBrowser/UI/Dialogs.cs b/WIP-v12/repository/desktop/src/FableBrowser/UI/Dialogs.cs
new file mode 100644
index 0000000..7b5ed72
--- /dev/null
+++ b/WIP-v12/repository/desktop/src/FableBrowser/UI/Dialogs.cs
@@ -0,0 +1,195 @@
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using System.Windows.Media.Imaging;
+using FableBrowser.Browser;
+using FableBrowser.Core;
+using Microsoft.Web.WebView2.Core;
+
+namespace FableBrowser.UI;
+
+public static class Dialogs
+{
+    static ImageSource? icon;
+
+    public static ImageSource AppIcon => icon ??= BitmapFrame.Create(new Uri("pack://application:,,,/Assets/fable.ico", UriKind.Absolute));
+
+    public static void Decorate(Window window)
+    {
+        window.Icon = AppIcon;
+        window.SetResourceReference(Control.BackgroundProperty, "FbWindow");
+        window.SetResourceReference(Control.ForegroundProperty, "FbText");
+        window.UseLayoutRounding = true;
+        window.SourceInitialized += (_, _) => NativeMethods.UseDarkTitleBar(window, App.IsDarkTheme);
+    }
+
+    public static Window Create(Window? owner, string title, double width)
+    {
+        var window = new Window
+        {
+            Title = title,
+            Width = width,
+            SizeToContent = SizeToContent.Height,
+            ResizeMode = ResizeMode.NoResize,
+            ShowInTaskbar = false,
+            WindowStartupLocation = owner != null ? WindowStartupLocation.CenterOwner : WindowStartupLocation.CenterScreen
+        };
+        if (owner != null && owner.IsLoaded) window.Owner = owner;
+        Decorate(window);
+        return window;
+    }
+
+    public static TextBlock Heading(string text)
+    {
+        var block = new TextBlock { Text = text, FontSize = 17, FontWeight = FontWeights.SemiBold, TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 0, 0, 8) };
+        block.SetResourceReference(TextBlock.ForegroundProperty, "FbText");
+        return block;
+    }
+
+    public static TextBlock Body(string text)
+    {
+        var block = new TextBlock { Text = text, TextWrapping = TextWrapping.Wrap, FontSize = 13.5 };
+        block.SetResourceReference(TextBlock.ForegroundProperty, "FbSubtle");
+        return block;
+    }
+
+    public static StackPanel ButtonRow(params Button[] buttons)
+    {
+        var row = new StackPanel { Orientation = Orientation.Horizontal, HorizontalAlignment = HorizontalAlignment.Right, Margin = new Thickness(0, 20, 0, 0) };
+        foreach (var button in buttons) row.Children.Add(button);
+        return row;
+    }
+
+    public static Button Primary(string text)
+    {
+        var button = new Button { Content = text, MinWidth = 96, Margin = new Thickness(8, 0, 0, 0), IsDefault = true };
+        button.Style = (Style)Application.Current.FindResource("AccentButton");
+        return button;
+    }
+
+    public static Button Secondary(string text, bool cancel = false)
+    {
+        var button = new Button { Content = text, MinWidth = 96, Margin = new Thickness(8, 0, 0, 0), IsCancel = cancel, Padding = new Thickness(14, 6, 14, 6) };
+        return button;
+    }
+}
+
+public static class PermissionDialog
+{
+    public readonly record struct Answer(bool Allow, bool Remember);
+
+    static string Describe(CoreWebView2PermissionKind kind) => kind switch
+    {
+        CoreWebView2PermissionKind.Camera => "Use your camera",
+        CoreWebView2PermissionKind.Microphone => "Use your microphone",
+        CoreWebView2PermissionKind.Geolocation => "Know your location",
+        CoreWebView2PermissionKind.Notifications => "Show notifications",
+        CoreWebView2PermissionKind.OtherSensors => "Use motion and light sensors",
+        CoreWebView2PermissionKind.ClipboardRead => "See text and images you copy to the clipboard",
+        CoreWebView2PermissionKind.LocalFonts => "See the fonts installed on this PC. Sites can use this to fingerprint you.",
+        CoreWebView2PermissionKind.MidiSystemExclusiveMessages => "Get full control of your MIDI devices",
+        CoreWebView2PermissionKind.WindowManagement => "Open and place windows on all your displays",
+        CoreWebView2PermissionKind.MultipleAutomaticDownloads => "Download several files automatically",
+        _ => "Use a special browser feature"
+    };
+
+    public static Answer Ask(Window owner, string origin, CoreWebView2PermissionKind kind, bool isPrivate)
+    {
+        var window = Dialogs.Create(owner, "Permission request", 460);
+        var panel = new StackPanel { Margin = new Thickness(24, 20, 24, 20) };
+        var host = UrlUtils.DisplayHost(origin);
+        panel.Children.Add(Dialogs.Heading((host.Length > 0 ? host : origin) + " wants to"));
+        panel.Children.Add(Dialogs.Body(Describe(kind)));
+        var remember = new CheckBox
+        {
+            Content = isPrivate ? "Remember while this private tab is open" : "Remember my choice for this site",
+            IsChecked = true,
+            Margin = new Thickness(0, 16, 0, 0)
+        };
+        panel.Children.Add(remember);
+        var allow = false;
+        var block = Dialogs.Secondary("Block", true);
+        var permit = Dialogs.Primary("Allow");
+        permit.IsDefault = false;
+        block.Click += (_, _) => window.DialogResult = false;
+        permit.Click += (_, _) =>
+        {
+            allow = true;
+            window.DialogResult = true;
+        };
+        panel.Children.Add(Dialogs.ButtonRow(block, permit));
+        window.Content = panel;
+        window.ShowDialog();
+        return new Answer(allow, remember.IsChecked == true);
+    }
+}
+
+public static class TextPrompt
+{
+    public static string? Ask(Window owner, string title, string prompt, string initial)
+    {
+        var window = Dialogs.Create(owner, title, 420);
+        var panel = new StackPanel { Margin = new Thickness(24, 20, 24, 20) };
+        panel.Children.Add(Dialogs.Body(prompt));
+        var box = new TextBox { Text = initial, Margin = new Thickness(0, 10, 0, 0), Padding = new Thickness(6, 4, 6, 4) };
+        panel.Children.Add(box);
+        var ok = Dialogs.Primary("OK");
+        var cancel = Dialogs.Secondary("Cancel", true);
+        string? result = null;
+        ok.Click += (_, _) =>
+        {
+            result = box.Text;
+            window.DialogResult = true;
+        };
+        panel.Children.Add(Dialogs.ButtonRow(cancel, ok));
+        window.Content = panel;
+        window.Loaded += (_, _) =>
+        {
+            box.Focus();
+            box.SelectAll();
+        };
+        window.ShowDialog();
+        return result;
+    }
+}
+
+public static class PinDialog
+{
+    public static string? AskNewPin(Window owner)
+    {
+        var window = Dialogs.Create(owner, "Set PIN", 400);
+        var panel = new StackPanel { Margin = new Thickness(24, 20, 24, 20) };
+        panel.Children.Add(Dialogs.Heading("Choose a PIN for private tabs"));
+        panel.Children.Add(Dialogs.Body("At least 4 characters. It is stored only as a salted hash on this PC."));
+        var first = new PasswordBox { Margin = new Thickness(0, 14, 0, 0), Height = 32 };
+        var second = new PasswordBox { Margin = new Thickness(0, 8, 0, 0), Height = 32 };
+        var error = new TextBlock { Margin = new Thickness(0, 8, 0, 0) };
+        error.SetResourceReference(TextBlock.ForegroundProperty, "FbDanger");
+        panel.Children.Add(first);
+        panel.Children.Add(second);
+        panel.Children.Add(error);
+        string? result = null;
+        var ok = Dialogs.Primary("Save");
+        var cancel = Dialogs.Secondary("Cancel", true);
+        ok.Click += (_, _) =>
+        {
+            if (first.Password.Length < 4)
+            {
+                error.Text = "The PIN is too short.";
+                return;
+            }
+            if (first.Password != second.Password)
+            {
+                error.Text = "The two PINs do not match.";
+                return;
+            }
+            result = first.Password;
+            window.DialogResult = true;
+        };
+        panel.Children.Add(Dialogs.ButtonRow(cancel, ok));
+        window.Content = panel;
+        window.Loaded += (_, _) => first.Focus();
+        window.ShowDialog();
+        return result;
+    }
+}
diff --git a/WIP-v12/repository/desktop/src/FableBrowser/UI/LibraryWindow.cs b/WIP-v12/repository/desktop/src/FableBrowser/UI/LibraryWindow.cs
new file mode 100644
index 0000000..83f9a35
--- /dev/null
+++ b/WIP-v12/repository/desktop/src/FableBrowser/UI/LibraryWindow.cs
@@ -0,0 +1,332 @@
+using System.Diagnostics;
+using System.Globalization;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Input;
+using FableBrowser.Browser;
+using FableBrowser.Core;
+
+namespace FableBrowser.UI;
+
+public enum LibraryPage { History, Bookmarks, Downloads }
+
+public sealed class LibraryWindow : Window
+{
+    readonly MainWindow main;
+    readonly TabControl pages = new() { Margin = new Thickness(12) };
+    readonly TextBox historySearch = new() { Padding = new Thickness(8, 5, 8, 5), Margin = new Thickness(0, 0, 0, 8) };
+    readonly ListBox historyList = new();
+    readonly ListBox bookmarkList = new();
+    readonly ListBox downloadList = new();
+    readonly Action historyChanged;
+    readonly Action bookmarksChanged;
+    readonly Action downloadsChanged;
+
+    public LibraryWindow(MainWindow main)
+    {
+        this.main = main;
+        Owner = main;
+        Title = "Library - Fable Browser";
+        Width = 820;
+        Height = 600;
+        MinWidth = 480;
+        MinHeight = 320;
+        WindowStartupLocation = WindowStartupLocation.CenterOwner;
+        Dialogs.Decorate(this);
+        pages.Items.Add(new TabItem { Header = "History", Content = BuildHistory() });
+        pages.Items.Add(new TabItem { Header = "Bookmarks", Content = BuildBookmarks() });
+        pages.Items.Add(new TabItem { Header = "Downloads", Content = BuildDownloads() });
+        Content = pages;
+        historyChanged = () => Dispatcher.InvokeAsync(RefreshHistory);
+        bookmarksChanged = () => Dispatcher.InvokeAsync(RefreshBookmarks);
+        downloadsChanged = () => Dispatcher.InvokeAsync(RefreshDownloads);
+        Library.History.Changed += historyChanged;
+        Library.Bookmarks.Changed += bookmarksChanged;
+        Library.Downloads.Changed += downloadsChanged;
+        Library.PrivateDownloads.Changed += downloadsChanged;
+        Closed += (_, _) =>
+        {
+            Library.History.Changed -= historyChanged;
+            Library.Bookmarks.Changed -= bookmarksChanged;
+            Library.Downloads.Changed -= downloadsChanged;
+            Library.PrivateDownloads.Changed -= downloadsChanged;
+        };
+        RefreshHistory();
+        RefreshBookmarks();
+        RefreshDownloads();
+    }
+
+    public void Show(LibraryPage page)
+    {
+        pages.SelectedIndex = (int)page;
+        if (!IsVisible) base.Show();
+        if (page == LibraryPage.History) historySearch.Focus();
+    }
+
+    static ListBoxItem Row(string title, string detail, string right, object tag)
+    {
+        var head = new TextBlock { Text = title, TextTrimming = TextTrimming.CharacterEllipsis, FontSize = 13.5 };
+        head.SetResourceReference(TextBlock.ForegroundProperty, "FbText");
+        var sub = new TextBlock { Text = detail, TextTrimming = TextTrimming.CharacterEllipsis, FontSize = 11.5 };
+        sub.SetResourceReference(TextBlock.ForegroundProperty, "FbSubtle");
+        var side = new TextBlock { Text = right, FontSize = 11.5, Margin = new Thickness(12, 0, 0, 0), VerticalAlignment = VerticalAlignment.Center };
+        side.SetResourceReference(TextBlock.ForegroundProperty, "FbSubtle");
+        var stack = new StackPanel();
+        stack.Children.Add(head);
+        stack.Children.Add(sub);
+        var dock = new DockPanel { Margin = new Thickness(6, 4, 6, 4), LastChildFill = true };
+        DockPanel.SetDock(side, Dock.Right);
+        dock.Children.Add(side);
+        dock.Children.Add(stack);
+        return new ListBoxItem { Content = dock, Tag = tag };
+    }
+
+    static Button MakeButton(string text, RoutedEventHandler handler)
+    {
+        var button = new Button { Content = text, Margin = new Thickness(0, 0, 8, 0), Padding = new Thickness(12, 5, 12, 5) };
+        button.Click += handler;
+        return button;
+    }
+
+    static DockPanel MakePage(UIElement top, UIElement list, params Button[] buttons)
+    {
+        var bar = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 10, 0, 0) };
+        foreach (var b in buttons) bar.Children.Add(b);
+        var dock = new DockPanel { Margin = new Thickness(4, 10, 4, 4) };
+        DockPanel.SetDock(top, Dock.Top);
+        DockPanel.SetDock(bar, Dock.Bottom);
+        dock.Children.Add(top);
+        dock.Children.Add(bar);
+        dock.Children.Add(list);
+        return dock;
+    }
+
+    UIElement BuildHistory()
+    {
+        historySearch.TextChanged += (_, _) => RefreshHistory();
+        historyList.MouseDoubleClick += (_, _) => OpenSelectedHistory(false);
+        historyList.SelectionMode = SelectionMode.Extended;
+        historyList.KeyDown += (_, e) =>
+        {
+            if (e.Key == Key.Delete) DeleteSelectedHistory();
+            if (e.Key == Key.Enter) OpenSelectedHistory(false);
+        };
+        var label = new TextBlock { Text = "Search history", Margin = new Thickness(0, 0, 0, 4) };
+        label.SetResourceReference(TextBlock.ForegroundProperty, "FbSubtle");
+        var top = new StackPanel();
+        top.Children.Add(label);
+        top.Children.Add(historySearch);
+        return MakePage(top, historyList,
+            MakeButton("Open", (_, _) => OpenSelectedHistory(false)),
+            MakeButton("Open in new tab", (_, _) => OpenSelectedHistory(true)),
+            MakeButton("Delete", (_, _) => DeleteSelectedHistory()),
+            MakeButton("Clear all history", (_, _) =>
+            {
+                if (MessageBox.Show(this, "Delete all browsing history from Fable?", "Clear history", MessageBoxButton.YesNo, MessageBoxImage.Question) != MessageBoxResult.Yes) return;
+                Library.History.Clear();
+                foreach (var tab in main.Tabs.Where(t => t.Core != null && t.Kind == TabKind.Normal).Take(1))
+                {
+                    _ = tab.Core!.Profile.ClearBrowsingDataAsync(Microsoft.Web.WebView2.Core.CoreWebView2BrowsingDataKinds.BrowsingHistory);
+                }
+            }));
+    }
+
+    void RefreshHistory()
+    {
+        historyList.Items.Clear();
+        foreach (var entry in Library.History.Search(historySearch.Text, 600))
+        {
+            var title = string.IsNullOrWhiteSpace(entry.Title) ? entry.Url : entry.Title;
+            historyList.Items.Add(Row(title, entry.Url, entry.LastVisit.ToString("g", CultureInfo.CurrentCulture), entry));
+        }
+    }
+
+    void OpenSelectedHistory(bool newTab)
+    {
+        var selected = historyList.SelectedItems.OfType<ListBoxItem>().Select(i => i.Tag).OfType<HistoryEntry>().ToList();
+        OpenUrls(selected.Select(e => e.Url), newTab);
+    }
+
+    void DeleteSelectedHistory()
+    {
+        foreach (var entry in historyList.SelectedItems.OfType<ListBoxItem>().Select(i => i.Tag).OfType<HistoryEntry>().ToList())
+        {
+            Library.History.Remove(entry.Url);
+        }
+    }
+
+    void OpenUrls(IEnumerable<string> urls, bool newTab)
+    {
+        var list = urls.ToList();
+        if (list.Count == 0) return;
+        if (!newTab && list.Count == 1 && main.ActiveTab != null && main.ActiveTab.Kind == TabKind.Normal)
+        {
+            _ = main.ActiveTab.NavigateAsync(list[0]);
+        }
+        else
+        {
+            foreach (var url in list) main.OpenTab(url, TabKind.Normal, true, null);
+        }
+        main.Activate();
+    }
+
+    UIElement BuildBookmarks()
+    {
+        bookmarkList.SelectionMode = SelectionMode.Extended;
+        bookmarkList.MouseDoubleClick += (_, _) => OpenSelectedBookmarks(false);
+        bookmarkList.KeyDown += (_, e) =>
+        {
+            if (e.Key == Key.Delete) DeleteSelectedBookmarks();
+            if (e.Key == Key.Enter) OpenSelectedBookmarks(false);
+        };
+        var hint = new TextBlock { Text = "Press Ctrl+D on any page to bookmark it.", Margin = new Thickness(0, 0, 0, 8) };
+        hint.SetResourceReference(TextBlock.ForegroundProperty, "FbSubtle");
+        return MakePage(hint, bookmarkList,
+            MakeButton("Open", (_, _) => OpenSelectedBookmarks(false)),
+            MakeButton("Open in new tab", (_, _) => OpenSelectedBookmarks(true)),
+            MakeButton("Rename", (_, _) => RenameBookmark()),
+            MakeButton("Delete", (_, _) => DeleteSelectedBookmarks()),
+            MakeButton("Import HTML", (_, _) => ImportBookmarks()),
+            MakeButton("Export HTML", (_, _) => ExportBookmarks()));
+    }
+
+    void RefreshBookmarks()
+    {
+        bookmarkList.Items.Clear();
+        foreach (var bookmark in Library.Bookmarks.Snapshot())
+        {
+            bookmarkList.Items.Add(Row(bookmark.Title, bookmark.Url, bookmark.Added.ToString("d", CultureInfo.CurrentCulture), bookmark));
+        }
+    }
+
+    List<Bookmark> SelectedBookmarks() => bookmarkList.SelectedItems.OfType<ListBoxItem>().Select(i => i.Tag).OfType<Bookmark>().ToList();
+
+    void OpenSelectedBookmarks(bool newTab) => OpenUrls(SelectedBookmarks().Select(b => b.Url), newTab);
+
+    void DeleteSelectedBookmarks()
+    {
+        foreach (var bookmark in SelectedBookmarks()) Library.Bookmarks.Remove(bookmark.Url);
+    }
+
+    void RenameBookmark()
+    {
+        var bookmark = SelectedBookmarks().FirstOrDefault();
+        if (bookmark == null) return;
+        var name = TextPrompt.Ask(this, "Rename bookmark", "Name:", bookmark.Title);
+        if (string.IsNullOrWhiteSpace(name)) return;
+        Library.Bookmarks.Remove(bookmark.Url);
+        Library.Bookmarks.Add(bookmark.Url, name.Trim());
+    }
+
+    void ImportBookmarks()
+    {
+        var dialog = new Microsoft.Win32.OpenFileDialog { Filter = "Bookmark files (*.html;*.htm)|*.html;*.htm|All files (*.*)|*.*" };
+        if (dialog.ShowDialog(this) != true) return;
+        try
+        {
+            var count = Library.Bookmarks.ImportHtml(File.ReadAllText(dialog.FileName));
+            MessageBox.Show(this, $"Imported {count} bookmarks.", "Import", MessageBoxButton.OK, MessageBoxImage.Information);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            MessageBox.Show(this, "Could not read the file: " + ex.Message, "Import", MessageBoxButton.OK, MessageBoxImage.Warning);
+        }
+    }
+
+    void ExportBookmarks()
+    {
+        var dialog = new Microsoft.Win32.SaveFileDialog { Filter = "Bookmark file (*.html)|*.html", FileName = "fable-bookmarks.html" };
+        if (dialog.ShowDialog(this) != true) return;
+        try
+        {
+            File.WriteAllText(dialog.FileName, Library.Bookmarks.ExportHtml());
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            MessageBox.Show(this, "Could not save the file: " + ex.Message, "Export", MessageBoxButton.OK, MessageBoxImage.Warning);
+        }
+    }
+
+    UIElement BuildDownloads()
+    {
+        downloadList.MouseDoubleClick += (_, _) => OpenDownload();
+        var hint = new TextBlock { Text = "Downloads from private tabs are listed only until Fable closes.", Margin = new Thickness(0, 0, 0, 8) };
+        hint.SetResourceReference(TextBlock.ForegroundProperty, "FbSubtle");
+        return MakePage(hint, downloadList,
+            MakeButton("Open file", (_, _) => OpenDownload()),
+            MakeButton("Show in folder", (_, _) => ShowDownloadInFolder()),
+            MakeButton("Remove from list", (_, _) =>
+            {
+                if (SelectedDownload() is { } entry)
+                {
+                    Library.Downloads.Remove(entry.Id);
+                    Library.PrivateDownloads.Remove(entry.Id);
+                }
+            }),
+            MakeButton("Clear finished", (_, _) =>
+            {
+                Library.Downloads.Clear();
+                Library.PrivateDownloads.Clear();
+            }),
+            MakeButton("Open downloads folder", (_, _) =>
+            {
+                var folder = SettingsStore.Current.DownloadFolder.Length > 0 ? SettingsStore.Current.DownloadFolder : MainWindow.DefaultDownloadFolder();
+                Directory.CreateDirectory(folder);
+                MainWindow.OpenExternal(folder);
+            }));
+    }
+
+    static string Size(long bytes)
+    {
+        if (bytes <= 0) return "";
+        string[] units = { "B", "KB", "MB", "GB", "TB" };
+        double value = bytes;
+        var unit = 0;
+        while (value >= 1024 && unit < units.Length - 1)
+        {
+            value /= 1024;
+            unit++;
+        }
+        return value.ToString(unit == 0 ? "0" : "0.0", CultureInfo.CurrentCulture) + " " + units[unit];
+    }
+
+    void RefreshDownloads()
+    {
+        var selectedId = SelectedDownload()?.Id;
+        downloadList.Items.Clear();
+        foreach (var entry in Library.PrivateDownloads.Snapshot().Concat(Library.Downloads.Snapshot()).OrderByDescending(d => d.Started))
+        {
+            var name = Path.GetFileName(entry.FilePath);
+            if (string.IsNullOrEmpty(name)) name = entry.Url;
+            var progress = entry.State == "In progress" && entry.Total > 0 ? $"{entry.Received * 100 / entry.Total}%  " : "";
+            var size = Size(entry.Total > 0 ? entry.Total : entry.Received);
+            var item = Row(name, entry.Url, progress + entry.State + (size.Length > 0 ? "  " + size : ""), entry);
+            downloadList.Items.Add(item);
+            if (entry.Id == selectedId) item.IsSelected = true;
+        }
+    }
+
+    DownloadEntry? SelectedDownload() => (downloadList.SelectedItem as ListBoxItem)?.Tag as DownloadEntry;
+
+    void OpenDownload()
+    {
+        var entry = SelectedDownload();
+        if (entry == null || entry.State != "Completed" || !File.Exists(entry.FilePath)) return;
+        MainWindow.OpenExternal(entry.FilePath);
+    }
+
+    void ShowDownloadInFolder()
+    {
+        var entry = SelectedDownload();
+        if (entry == null) return;
+        try
+        {
+            if (File.Exists(entry.FilePath)) Process.Start(new ProcessStartInfo("explorer.exe", "/select,\"" + entry.FilePath + "\"") { UseShellExecute = false });
+            else if (Path.GetDirectoryName(entry.FilePath) is { } folder && Directory.Exists(folder)) MainWindow.OpenExternal(folder);
+        }
+        catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
+        {
+            CrashLog.Write("Could not show download", ex);
+        }
+    }
+}
