+
+    fun exportJson(): JSONArray = JSONArray().apply { all().forEach { put(it.toJson()) } }
+
+    fun importJson(arr: JSONArray): Int {
+        var count = 0
+        for (i in 0 until arr.length()) {
+            val item = arr.optJSONObject(i)?.let(SavedLogin::fromJson) ?: continue
