+        new("Windows laptop, Intel UHD", "Windows", 1536, 864, 40, "Google Inc. (Intel)", "ANGLE (Intel, Intel(R) UHD Graphics Direct3D11 vs_5_0 ps_5_0, D3D11)", new[] { 4, 8 }, new[] { 4, 8 }),
