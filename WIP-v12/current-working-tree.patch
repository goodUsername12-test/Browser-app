+    fun deviceChoices(): List<Choice> = devices.map { d ->
+        Choice(
+            d.label,
+            when (d.kind) {
+                PHONE -> "Android phones"
+                TABLET -> "Android tablets"
+                WINDOWS -> "Windows"
