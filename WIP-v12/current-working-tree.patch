+    }
+
+    if (newFolderOpen) {
+        TextPromptDialog(
+            title = "New folder",
+            label = "Folder name",
+            initial = "",
+            onDismiss = { newFolderOpen = false },
+            onConfirm = {
+                viewModel.addFolder(it)
+                newFolderOpen = false
+            }
+        )
