+    @TaskAction
+    fun fetch() {
+        val dir = outputDir.get().dir("filters").asFile.apply { mkdirs() }
+        val lists = listOf(
+            "easylist.txt" to "https://easylist.to/easylist/easylist.txt",
+            "easyprivacy.txt" to "https://easylist.to/easylist/easyprivacy.txt",
