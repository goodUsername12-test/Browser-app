<Window x:Class="FableBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:browser="clr-namespace:FableBrowser.Browser"
        x:Name="Root"
        Title="Fable Browser"
        Width="1280" Height="820" MinWidth="520" MinHeight="360"
        Icon="pack://application:,,,/Assets/fable.ico"
        Background="{DynamicResource FbWindow}"
        Foreground="{DynamicResource FbText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="TabTemplate" DataType="{x:Type browser:BrowserTab}">
            <Border x:Name="Bd"
                    Width="{Binding TabWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="34" Margin="0,6,3,0" CornerRadius="9,9,0,0"
                    Background="{DynamicResource FbTab}"
                    BorderThickness="0,2,0,0" BorderBrush="Transparent"
                    ToolTip="{Binding Title}"
                    Tag="{Binding}"
                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                    MouseUp="Tab_MouseUp"
                    MouseRightButtonUp="Tab_MouseRightButtonUp">
                <Grid Margin="10,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="KindGlyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource FbSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Favicon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Opacity="{Binding TitleOpacity}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource FbText}"/>
                    <Button Grid.Column="2" Style="{StaticResource TabIconButton}" Content="{Binding AudioGlyph}" Visibility="{Binding AudioVisibility}" Tag="{Binding}" Click="TabMute_Click" ToolTip="Mute or unmute this tab"/>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource TabIconButton}" Content="&#xE711;" Tag="{Binding}" Click="TabClose_Click" ToolTip="Close tab (Ctrl+W)"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FbTabHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FbTabActive}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Incognito">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FbIncognito}"/>
                    <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource FbIncognito}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Super">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FbSuper}"/>
                    <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource FbSuper}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ConsoleRow" Height="0"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TabStrip" Grid.Row="0" Background="{DynamicResource FbChrome}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="TabArea" Grid.Column="0" LastChildFill="False" Margin="6,0,0,0">
                <ScrollViewer x:Name="TabScroller" DockPanel.Dock="Left" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScroller_PreviewMouseWheel" Focusable="False">
                    <ItemsControl x:Name="TabList" ItemTemplate="{StaticResource TabTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <Button DockPanel.Dock="Left" Style="{StaticResource SmallIconButton}" Content="&#xE710;" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" Margin="4,6,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,6,8,0" VerticalAlignment="Center">
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE8D7;" Foreground="{DynamicResource FbIncognito}" ToolTip="New incognito tab (Ctrl+Shift+N)" Click="NewIncognito_Click"/>
                <Button Style="{StaticResource SmallIconButton}" Content="&#xEA18;" Foreground="{DynamicResource FbSuper}" ToolTip="New super incognito tab (Ctrl+Alt+N)" Click="NewSuper_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource FbToolbar}" BorderBrush="{DynamicResource FbLine}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="6,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" Click="Back_Click"/>
                    <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="Forward_Click"/>
                    <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload (F5)" Click="Reload_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE80F;" ToolTip="Home (Alt+Home)" Click="Home_Click"/>
                    <Border x:Name="OmniboxBorder" Grid.Column="4" Margin="6,0" Height="34" CornerRadius="17" Background="{DynamicResource FbOmnibox}" BorderBrush="{DynamicResource FbOmniboxBorder}" BorderThickness="1">
                        <Grid Margin="12,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SecurityIcon" Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE721;" Foreground="{DynamicResource FbSubtle}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="OmniboxHint" Grid.Column="1" Text="Search or type a web address" Foreground="{DynamicResource FbSubtle}" VerticalAlignment="Center" FontSize="14" IsHitTestVisible="False"/>
                            <TextBox x:Name="Omnibox" Grid.Column="1" Style="{StaticResource BareTextBox}" VerticalAlignment="Center"
                                     PreviewKeyDown="Omnibox_PreviewKeyDown"
                                     TextChanged="Omnibox_TextChanged"
                                     GotKeyboardFocus="Omnibox_GotKeyboardFocus"
                                     LostKeyboardFocus="Omnibox_LostKeyboardFocus"
                                     PreviewMouseLeftButtonDown="Omnibox_PreviewMouseLeftButtonDown"/>
                            <Border x:Name="ModeBadge" Grid.Column="2" CornerRadius="10" Padding="9,2" Margin="6,0" VerticalAlignment="Center" Visibility="Collapsed" Background="{DynamicResource FbIncognito}">
                                <TextBlock x:Name="ModeBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Incognito"/>
                            </Border>
                            <Button x:Name="StarButton" Grid.Column="3" Style="{StaticResource SmallIconButton}" Content="&#xE734;" ToolTip="Bookmark this page (Ctrl+D)" Click="Star_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button x:Name="ShieldButton" Style="{StaticResource IconButton}" ToolTip="Shield" Click="Shield_Click">
                            <Grid>
                                <TextBlock x:Name="ShieldGlyph" Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource FbAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="ShieldBadge" Background="{DynamicResource FbAccentStrong}" CornerRadius="6" MinWidth="12" Height="12" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-11,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ShieldCount" FontSize="8.5" FontFamily="Segoe UI" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Downloads (Ctrl+J)" Click="Downloads_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE756;" ToolTip="Fable Console (Ctrl+Shift+K)" Click="Console_Click"/>
                        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menu" Click="Menu_Click"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="LoadingBar" Height="2" VerticalAlignment="Bottom" IsIndeterminate="False" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource FbAccent}" MinHeight="0"/>
            </Grid>
        </Border>

        <Border x:Name="InfoBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource FbInfo}" BorderBrush="{DynamicResource FbLine}" BorderThickness="0,0,0,1" Padding="14,5,8,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE711;" ToolTip="Dismiss" Click="InfoClose_Click"/>
                <StackPanel x:Name="InfoActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource FbAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="{DynamicResource FbText}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border x:Name="FindBar" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource FbToolbar}" BorderBrush="{DynamicResource FbLine}" BorderThickness="0,0,0,1" Padding="10,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border CornerRadius="8" Background="{DynamicResource FbOmnibox}" Padding="10,0" Width="280" Height="30">
                    <TextBox x:Name="FindBox" Style="{StaticResource BareTextBox}" VerticalAlignment="Center" TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"/>
                </Border>
                <TextBlock x:Name="FindStatus" Margin="10,0" MinWidth="64" VerticalAlignment="Center" Foreground="{DynamicResource FbSubtle}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Previous match (Shift+F3)" Click="FindPrevious_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Next match (F3)" Click="FindNext_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="FindClose_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid x:Name="ViewHost"/>
            <Grid x:Name="LockOverlay" Visibility="Collapsed" Background="{DynamicResource FbWindow}">
                <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource FbAccent}"/>
                    <TextBlock Text="Private tabs are locked" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,6" HorizontalAlignment="Center" Foreground="{DynamicResource FbText}"/>
                    <TextBlock Text="Enter your PIN to continue." HorizontalAlignment="Center" Foreground="{DynamicResource FbSubtle}"/>
                    <PasswordBox x:Name="LockPin" Margin="0,18,0,0" Height="36" FontSize="16" KeyDown="LockPin_KeyDown"/>
                    <TextBlock x:Name="LockError" Margin="0,8,0,0" Foreground="{DynamicResource FbDanger}" HorizontalAlignment="Center"/>
                    <Button Content="Unlock" Margin="0,10,0,0" Height="36" Style="{StaticResource AccentButton}" Click="Unlock_Click"/>
                    <Button Content="Close private tabs instead" Margin="0,8,0,0" Style="{StaticResource TextButton}" Click="LockWipe_Click"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ErrorOverlay" Visibility="Collapsed" Background="{DynamicResource FbWindow}">
                <StackPanel MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/fable.png" Width="88" Height="88" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorTitle" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource FbText}"/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource FbSubtle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="ErrorAction" Style="{StaticResource AccentButton}" Click="ErrorAction_Click"/>
                        <Button Content="Try again" Style="{StaticResource TextButton}" Margin="10,0,0,0" Click="ErrorRetry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter x:Name="ConsoleSplitter" Grid.Row="5" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource FbLine}" Visibility="Collapsed" Focusable="False"/>

        <Grid x:Name="ConsolePanel" Grid.Row="6" Visibility="Collapsed" Background="{DynamicResource FbToolbar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="8,5">
                <TextBlock DockPanel.Dock="Left" Text="Fable Console" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,14,0" Foreground="{DynamicResource FbText}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close console" Click="ConsoleClose_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xEC7A;" ToolTip="Open developer tools (F12)" Click="DevTools_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE894;" ToolTip="Clear output" Click="ConsoleClear_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Run" Style="{StaticResource AccentButton}" Padding="16,4" ToolTip="Run in the current page (Ctrl+Enter)" Click="ConsoleRun_Click"/>
                    <ComboBox x:Name="SnippetBox" Width="190" Margin="10,0,0,0" DisplayMemberPath="Name" SelectionChanged="SnippetBox_SelectionChanged" ToolTip="Saved snippets"/>
                    <Button Content="Save snippet" Style="{StaticResource TextButton}" Click="SnippetSave_Click"/>
                    <Button Content="Delete" Style="{StaticResource TextButton}" Click="SnippetDelete_Click"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ConsoleInput" Grid.Column="0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="ConsoleInput_PreviewKeyDown"/>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"/>
                <TextBox x:Name="ConsoleOutput" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
